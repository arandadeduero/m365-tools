{
  "name": "m365-users",
  "version": "1.0.0",
  "description": "CLI tool to manage Microsoft 365 users via Graph API",
  "type": "module",
  "bin": {
    "m365-users": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "ava",
    "test:coverage": "c8 ava",
    "postinstall": "node -e \"try{const fs=require('fs'),p='./node_modules/c8/node_modules/yargs/package.json';if(fs.existsSync(p)){const pkg=JSON.parse(fs.readFileSync(p,'utf8'));delete pkg.type;fs.writeFileSync(p,JSON.stringify(pkg,null,2));}}catch(e){}\""
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "concurrency": 1,
    "nodeArguments": [
      "--experimental-vm-modules"
    ]
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "test/**"
    ]
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "exceljs": "^4.4.0",
    "inquirer": "^14.0.2",
    "ora": "^9.4.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "ava": "^8.0.1",
    "c8": "^11.0.0"
  }
}
